{
  "datasets": [
    {
      "name": "departamentos",
      "displayName": "Departamentos",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(department, 'Sin departamento') AS department,\n",
        "  total_unidades,\n",
        "  total_pedidos,\n",
        "  total_clientes\n",
        "FROM\n",
        "  smartdata_dev.gold.kpi_departamentos\n",
        "ORDER BY\n",
        "  total_unidades DESC"
      ]
    },
    {
      "name": "top_productos",
      "displayName": "Top 15 Productos",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  department,\n",
        "  aisle,\n",
        "  total_unidades,\n",
        "  total_pedidos,\n",
        "  total_clientes,\n",
        "  total_recompras,\n",
        "  ROUND(porcentaje_recompra, 2) AS porcentaje_recompra\n",
        "FROM\n",
        "  smartdata_dev.gold.kpi_productos\n",
        "WHERE\n",
        "  product_name IS NOT NULL\n",
        "ORDER BY\n",
        "  total_unidades DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "kpis_generales",
      "displayName": "KPIs Generales",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT order_id) AS total_pedidos,\n",
        "  COUNT(DISTINCT user_id) AS clientes_unicos,\n",
        "  COUNT(DISTINCT product_id) AS productos_distintos,\n",
        "  COUNT(*) AS productos_comprados,\n",
        "  ROUND(AVG(CAST(reordered AS DOUBLE)) * 100, 2) AS porcentaje_recompra\n",
        "FROM\n",
        "  smartdata_dev.gold.fact_compras"
      ]
    },
    {
      "name": "top_clientes",
      "displayName": "Top 15 Clientes",
      "queryLines": [
        "SELECT\n",
        "  user_id,\n",
        "  total_pedidos,\n",
        "  total_productos_comprados,\n",
        "  productos_diferentes,\n",
        "  total_recompras,\n",
        "  ROUND(total_recompras * 100.0 / NULLIF(total_productos_comprados, 0), 2) AS porcentaje_recompra\n",
        "FROM\n",
        "  smartdata_dev.gold.kpi_clientes\n",
        "ORDER BY\n",
        "  total_productos_comprados DESC\n",
        "LIMIT 15"
      ]
    }
  ],
